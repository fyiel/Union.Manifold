{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Union.Manifold",
  "version": "3.7.2",
  "identifier": "fyi.pumg.unionmanifold",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:renderer",
    "beforeBundleCommand": "node ./scripts/prepare-appimage.mjs",
    "frontendDist": "../renderer/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Union.Manifold",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#151515"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https: uc-asset://localhost http://uc-asset.localhost; font-src 'self' data:; connect-src 'self' http: https: uc-asset://localhost http://uc-asset.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "targets": ["appimage", "nsis", "deb", "rpm", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/union-manifold-aria2c", "binaries/union-manifold-7z"],
    "resources": {
      "resources/cacert.pem": "resources/cacert.pem",
      "resources/trainer-host-x64.exe": "resources/trainer-host-x64.exe",
      "resources/trainer-host-x86.exe": "resources/trainer-host-x86.exe",
      "../union-manifold-signing-key.asc": "union-manifold-signing-key.asc"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": ["gtk3", "webkit2gtk4.1", "libappindicator-gtk3", "librsvg2", "xdg-utils"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["unionmanifold", "nxm", "wemod"] }
    },
    "updater": {
      "endpoints": [
        "https://github.com/fyiel/Union.Manifold/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTU0ODU4NTU2NzQ0NjAKUldSZ1JHZFZXRWlWaXN4WFRlN28zRGovb3M0WWxwa05xRlJlTko1QU0wYzBLRzZWaXdTZFlGZkQK"
    }
  }
}
