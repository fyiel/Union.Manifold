{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Union.Manifold",
  "version": "3.4.7",
  "identifier": "fyi.pumg.unionmanifold",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../renderer/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Union.Manifold",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#151515"
      },
      {
        "label": "achievement-toast",
        "title": "Achievement unlocked",
        "url": "index.html#/achievement-toast",
        "width": 420,
        "height": 112,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "nsis", "deb", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aria2c", "binaries/7z"],
    "resources": ["resources/cacert.pem"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["unionmanifold", "nxm"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/fyiel/Union.Manifold/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTU0ODU4NTU2NzQ0NjAKUldSZ1JHZFZXRWlWaXN4WFRlN28zRGovb3M0WWxwa05xRlJlTko1QU0wYzBLRzZWaXdTZFlGZkQK"
    }
  }
}
